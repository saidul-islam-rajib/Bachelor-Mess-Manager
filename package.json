{
  "name": "bachelor-point",
  "version": "1.0.0",
  "private": true,
  "description": "Mess management for bachelor messes and shared flats: approvals, groups, meals, bazar, bills, dues and payments.",
  "author": {
    "name": "Team Sober",
    "email": "saidul.is.rajib@gmail.com",
    "url": "https://team-sober.com/"
  },
  "contributors": [
    {
      "name": "Team Sober",
      "email": "saidul.is.rajib@gmail.com",
      "role": "Author & Lead Developer"
    }
  ],
  "license": "MIT",
  "keywords": [
    "mess-management",
    "meal-tracking",
    "expense-sharing",
    "nextjs",
    "prisma",
    "sql-server"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "prisma generate && tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:sync-roles": "node scripts/sync-roles.js",
    "admin:init": "node scripts/init-admin.js",
    "user:password": "node scripts/reset-password.js",
    "cleanup:unverified": "node scripts/cleanup-unverified.js",
    "seed:db": "node prisma/seed.js",
    "setup": "npm run prisma:deploy && npm run db:sync-roles && npm run admin:init",
    "backup:db": "node scripts/backup-db.js",
    "restore:db": "node scripts/restore-db.js",
    "test:e2e": "node scripts/e2e-test.js",
    "test:rate": "node scripts/check-meal-rate.js",
    "test": "node scripts/test-all.js",
    "test:all": "node scripts/test-all.js",
    "test:allocation": "node scripts/check-allocation.js",
    "icons:generate": "node scripts/generate-icons.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.35",
    "prisma": "^5.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.6.2"
  }
}
