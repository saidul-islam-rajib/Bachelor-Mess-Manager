# dependencies
/node_modules
/.pnp
.pnp.js

# next.js build output and caches (regenerated on every dev run / build)
/.next/
/out/
/build
next-env.d.ts

# typescript incremental cache
*.tsbuildinfo

# env — keep the DB connection string out of the repo
.env
.env*.local
!.env.example

# user-uploaded profile images (runtime data, not source)
# outside /public on purpose — Next snapshots that directory at build time
/uploads/

# testing
/coverage

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# editors / os
.vscode/
.idea/
.DS_Store

# misc
*.pem
.vercel

# terraform
.terraform/
*.tfplan
tfplan
*.tfstate
*.tfstate.*
errored.tfstate
crash.log
*.tfvars
!*.tfvars.example
.terraformrc
terraform.rc

# local credential dumps - never commit
*.local.md
credentials.txt
