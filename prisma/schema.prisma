model CommunityMessage {
  id               String                  @id @default(uuid())
  type             String                  @default("MEMBER")
  key              String                  @unique
  author           User?                   @relation("CommunityAuthor", fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  authorId         String?
  title            String?
  text             String
  pinned           Boolean                 @default(false)
  listingType      String?
  rent             Float?
  rentNegotiable   Boolean                 @default(false)
  location         String?
  latitude         Float?
  longitude        Float?
  genderPreference String?
  tenantRestriction String?
  availableMonth   String?
  contactName      String?
  contactPhone     String?
  listingStatus    String?
  expiresAt        DateTime?
  viewCount        Int                     @default(0)
  likeCount        Int                     @default(0)
  commentCount     Int                     @default(0)
  deletedAt        DateTime?
  images           CommunityMessageImage[]
  likes            CommunityLike[]
  comments         CommunityComment[]
  createdAt        DateTime                @default(now())
  createdById      String?
  updatedAt        DateTime                @default(now()) @updatedAt
  updatedById      String?
  isPublished      Boolean                 @default(true)
  publishedAt      DateTime?
  unpublishedAt    DateTime?

  @@index([createdAt])
  @@index([pinned, createdAt])
  @@index([type, listingStatus, expiresAt])
}

