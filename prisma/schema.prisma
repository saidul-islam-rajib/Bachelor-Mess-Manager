generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  code          String           @id
  name          String
  description   String?
  rank          Int              @default(0)
  isSystem      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  createdById   String?
  updatedAt     DateTime         @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean          @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
  users         User[]
  permissions   RolePermission[]
}

model Permission {
  code          String           @id
  name          String
  description   String?
  category      String
  createdAt     DateTime         @default(now())
  createdById   String?
  updatedAt     DateTime         @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean          @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
  roles         RolePermission[]
  users         UserPermission[]
}

model RolePermission {
  id             String     @id @default(uuid())
  role           Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade, onUpdate: NoAction)
  roleCode       String
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade, onUpdate: NoAction)
  permissionCode String
  createdAt      DateTime   @default(now())
  createdById    String?
  updatedAt      DateTime   @default(now()) @updatedAt
  updatedById    String?
  isPublished    Boolean    @default(true)
  publishedAt    DateTime?
  unpublishedAt  DateTime?

  @@unique([roleCode, permissionCode])
  @@index([roleCode])
}

model UserPermission {
  id             String     @id @default(uuid())
  user           User       @relation("UserPermissionSubject", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId         String
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade, onUpdate: NoAction)
  permissionCode String
  effect         String     @default("ALLOW")
  note           String?
  grantedBy      User?      @relation("UserPermissionGrantor", fields: [grantedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grantedById    String?
  createdAt      DateTime   @default(now())
  createdById    String?
  updatedAt      DateTime   @default(now()) @updatedAt
  updatedById    String?
  isPublished    Boolean    @default(true)
  publishedAt    DateTime?
  unpublishedAt  DateTime?

  @@unique([userId, permissionCode])
  @@index([userId])
}

model User {
  id                  String              @id @default(uuid())
  name                String
  email               String              @unique
  password            String
  phone               String?
  profileImage        String?
  role                String              @default("MEMBER")
  roleRef             Role                @relation(fields: [role], references: [code], onDelete: NoAction, onUpdate: NoAction)
  status              String              @default("PENDING")
  tokenVersion        Int                 @default(0)
  lastLoginAt         DateTime?
  createdAt           DateTime            @default(now())
  createdById         String?
  updatedAt           DateTime            @default(now()) @updatedAt
  updatedById         String?
  isPublished         Boolean             @default(true)
  publishedAt         DateTime?
  unpublishedAt       DateTime?
  memberships         Membership[]
  comments            Comment[]
  mealEntries         MealEntry[]
  mealPlans           MealPlan[]
  expensePayments     ExpenseEntry[]      @relation("ExpensePayer")
  expenseHistory      ExpenseHistory[]    @relation("ExpenseHistoryActor")
  expenseComments     ExpenseComment[]    @relation("ExpenseCommentAuthor")
  expenseShares       ExpenseShare[]
  commentReplies      CommentReply[]      @relation("CommentReplyAuthor")
  groupOrders         GroupOrder[]
  payments            PaymentStatus[]
  paymentsRecorded    PaymentStatus[]     @relation("PaymentRecorder")
  paymentsReceived    PaymentStatus[]     @relation("PaymentRecipient")
  advances            MemberAdvance[]
  advancesRecorded    MemberAdvance[]     @relation("AdvanceRecorder")
  groupsSupervised    Group[]             @relation("GroupSupervisor")
  groupsCoSupervised  GroupSupervisor[]   @relation("GroupCoSupervisor")
  coSupervisorsAdded  GroupSupervisor[]   @relation("GroupCoSupervisorGrantor")
  invitationsReceived Invitation[]        @relation("InvitationInvitee")
  invitationsSent     Invitation[]        @relation("InvitationInviter")
  roleRequests        RoleRequest[]       @relation("RoleRequestUser")
  roleDecisions       RoleRequest[]       @relation("RoleRequestDecider")
  passwordTokens      PasswordToken[]
  notifications       Notification[]      @relation("NotificationRecipient")
  notificationsSent   Notification[]      @relation("NotificationActor")
  mealEditWindows     MealEditWindow[]
  mealChangeRequests  MealChangeRequest[] @relation("MealChangeSubject")
  mealChangeDecisions MealChangeRequest[] @relation("MealChangeDecider")
  closingsRun         MonthClosing[]      @relation("MonthClosingActor")
  closingLines        ClosingLine[]
  communityMessages   CommunityMessage[]  @relation("CommunityAuthor")
  communityRead       CommunityRead?
  communityLikes         CommunityLike[]         @relation("CommunityLikeUser")
  communityComments      CommunityComment[]      @relation("CommunityCommentUser")
  communityCommentReplies CommunityCommentReply[] @relation("CommunityCommentReplyUser")
  mealPrompts         MealPrompt[]
  sessions            UserSession[]
  permissionOverrides UserPermission[]    @relation("UserPermissionSubject")
  permissionsGranted  UserPermission[]    @relation("UserPermissionGrantor")

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model RoleRequest {
  id            String    @id @default(uuid())
  user          User      @relation("RoleRequestUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  requestedRole String
  status        String    @default("PENDING")
  reason        String?
  decidedBy     User?     @relation("RoleRequestDecider", fields: [decidedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@index([userId, status])
  @@index([status, createdAt])
}

model PasswordToken {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId        String
  tokenHash     String    @unique
  purpose       String
  expiresAt     DateTime
  usedAt        DateTime?
  requestedIp   String?
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@index([userId, purpose])
  @@index([expiresAt])
}

model LoginAttempt {
  id            String    @id @default(uuid())
  email         String
  ipAddress     String
  userAgent     String?
  successful    Boolean   @default(false)
  reason        String?
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([createdAt])
}

model UserSession {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId        String
  startedAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  endedAt       DateTime?
  endedReason   String?
  seconds       Int       @default(0)
  startHour     Int       @default(0)
  startWeekday  Int       @default(0)
  startDay      String    @default("")
  device        String    @default("DESKTOP")
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@index([userId, startedAt])
  @@index([startedAt])
  @@index([userId, endedAt])
  @@index([startDay])
}

model Group {
  id                       String              @id @default(uuid())
  name                     String
  supervisor               User                @relation("GroupSupervisor", fields: [supervisorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supervisorId             String
  status                   String              @default("ACTIVE")
  mealWeightBreakfast      Float               @default(0.5)
  mealWeightLunch          Float               @default(1)
  mealWeightDinner         Float               @default(1)
  mealRateMode             String              @default("MONTHLY")
  carryForwardEnabled      Boolean             @default(true)
  mealEditRequiresApproval Boolean?
  maxSupervisors           Int?
  createdAt                DateTime            @default(now())
  createdById              String?
  updatedAt                DateTime            @default(now()) @updatedAt
  updatedById              String?
  isPublished              Boolean             @default(true)
  publishedAt              DateTime?
  unpublishedAt            DateTime?
  memberships              Membership[]
  meals                    MealEntry[]
  mealPlans                MealPlan[]
  expenses                 ExpenseEntry[]
  expenseHistory           ExpenseHistory[]
  orders                   GroupOrder[]
  payments                 PaymentStatus[]
  advances                 MemberAdvance[]
  comments                 Comment[]
  invitations              Invitation[]
  categories               ExpenseCategory[]
  notifications            Notification[]
  mealEditWindows          MealEditWindow[]
  mealChangeRequests       MealChangeRequest[]
  closings                 MonthClosing[]
  mealPrompts              MealPrompt[]
  coSupervisors            GroupSupervisor[]

  @@index([supervisorId])
  @@index([status])
}

/// A second supervisor for a group, alongside the primary one on Group.supervisorId.
/// The primary is deliberately NOT a row here: it stays a required column so every
/// group always has exactly one owner to hand over, and only the extras are optional.
/// How many are allowed is SiteSettings.maxSupervisorsPerGroup, overridable per group
/// by Group.maxSupervisors, and the primary counts towards that total.
model GroupSupervisor {
  id            String    @id @default(uuid())
  group         Group     @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  groupId       String
  user          User      @relation("GroupCoSupervisor", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId        String
  addedBy       User?     @relation("GroupCoSupervisorGrantor", fields: [addedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  addedById     String?
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@unique([groupId, userId])
  @@index([userId])
}

model ExpenseCategory {
  id            String    @id @default(uuid())
  group         Group     @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  groupId       String
  code          String
  label         String
  isSystem      Boolean   @default(false)
  sortOrder     Int       @default(0)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@unique([groupId, code])
  @@index([groupId, archivedAt])
}

model Notification {
  id            String    @id @default(uuid())
  user          User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  actor         User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorId       String?
  type          String
  group         Group?    @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String?
  title         String?
  excerpt       String?
  link          String
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([groupId, createdAt])
}

model MealEditWindow {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  group         Group     @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  openedAt      DateTime  @default(now())
  expiresAt     DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@unique([userId, groupId])
  @@index([expiresAt])
}

model MealChangeRequest {
  id            String    @id @default(uuid())
  user          User      @relation("MealChangeSubject", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  group         Group     @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  date          DateTime
  fromBreakfast Int       @default(0)
  fromLunch     Int       @default(0)
  fromDinner    Int       @default(0)
  toBreakfast   Int       @default(0)
  toLunch       Int       @default(0)
  toDinner      Int       @default(0)
  reason        String?
  status        String    @default("PENDING")
  decidedBy     User?     @relation("MealChangeDecider", fields: [decidedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@index([groupId, status, date])
  @@index([userId, status])
}

model MonthClosing {
  id            String        @id @default(uuid())
  group         Group         @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  monthKey      String
  closedThrough DateTime
  closedBy      User?         @relation("MonthClosingActor", fields: [closedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  closedById    String?
  note          String?
  reopenedAt    DateTime?
  createdAt     DateTime      @default(now())
  createdById   String?
  updatedAt     DateTime      @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean       @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
  lines         ClosingLine[]

  @@index([groupId, monthKey])
}

model ClosingLine {
  id            String       @id @default(uuid())
  closing       MonthClosing @relation(fields: [closingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  closingId     String
  user          User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  carryIn       Float        @default(0)
  mealCount     Float        @default(0)
  mealCost      Float        @default(0)
  billShare     Float        @default(0)
  bazarPaid     Float        @default(0)
  cashPaid      Float        @default(0)
  carryOut      Float        @default(0)
  isFinal       Boolean      @default(true)
  createdAt     DateTime     @default(now())
  createdById   String?
  updatedAt     DateTime     @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean      @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@unique([closingId, userId])
  @@index([userId])
}

model SiteSettings {
  id                String  @id @default("singleton")
  companyName       String  @default("Bachelor Point")
  tagline           String?
  address           String?
  contactEmail      String?
  contactPhone      String?
  copyrightOwner    String  @default("Bachelor Point")
  facebookUrl       String?
  twitterUrl        String?
  newsletterEnabled Boolean @default(true)

  maxLoginAttempts          Int     @default(5)
  loginLockoutMinutes       Int     @default(15)
  maxLoginAttemptsPerIp     Int     @default(40)
  ipLockoutMinutes          Int     @default(15)
  maxRegistrationsPerIp     Int     @default(5)
  registrationWindowMinutes Int     @default(60)
  requireStrongPasswords    Boolean @default(false)
  autoApproveSupervisor     Boolean @default(false)
  autoApproveRegistration   Boolean @default(true)
  allowSelfRoleSwitch       Boolean @default(true)
  mealEditWindowMinutes     Int     @default(5)
  mealEditRequiresApproval  Boolean @default(true)
  maxProfileImageBytes      Int     @default(2097152)
  maxSupervisorsPerGroup    Int     @default(1)
  notificationsEnabled      Boolean @default(true)
  disabledNotificationTypes String  @default("")

  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
}

model Subscriber {
  id            String    @id @default(uuid())
  email         String    @unique
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
}

model Invitation {
  id            String    @id @default(uuid())
  group         Group     @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  invitee       User      @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inviteeId     String
  inviter       User      @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invitedById   String
  status        String    @default("PENDING")
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@index([inviteeId, status])
  @@index([groupId, status])
}

model Membership {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  group         Group     @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  joinedAt      DateTime  @default(now())
  leftAt        DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@index([userId, isActive])
  @@index([groupId, isActive])
}

model MealEntry {
  id             String    @id @default(uuid())
  user           User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId         String
  group          Group     @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId        String
  date           DateTime
  breakfastCount Int       @default(0)
  lunchCount     Int       @default(0)
  dinnerCount    Int       @default(0)
  totalMeals     Int       @default(0)
  fromPlan       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  createdById    String?
  updatedAt      DateTime  @default(now()) @updatedAt
  updatedById    String?
  isPublished    Boolean   @default(true)
  publishedAt    DateTime?
  unpublishedAt  DateTime?

  @@unique([userId, groupId, date])
  @@index([groupId, date])
  @@index([userId, date])
}

model MealPlan {
  id            String        @id @default(uuid())
  user          User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  group         Group         @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  isActive      Boolean       @default(true)
  startDate     DateTime
  createdAt     DateTime      @default(now())
  createdById   String?
  updatedAt     DateTime      @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean       @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
  days          MealPlanDay[]

  @@unique([userId, groupId])
}

model MealPlanDay {
  id            String    @id @default(uuid())
  plan          MealPlan  @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  planId        String
  weekday       Int
  enabled       Boolean   @default(false)
  breakfast     Int       @default(0)
  lunch         Int       @default(0)
  dinner        Int       @default(0)
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@unique([planId, weekday])
}

model ExpenseEntry {
  id            String           @id @default(uuid())
  group         Group            @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  type          String
  amount        Float
  date          DateTime
  payer         User?            @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  payerId       String?
  isReceived    Boolean          @default(false)
  splitMethod   String
  note          String?
  createdAt     DateTime         @default(now())
  createdById   String?
  updatedAt     DateTime         @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean          @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
  payments      PaymentStatus[]
  advances      MemberAdvance[]
  items         ExpenseItem[]
  comments      ExpenseComment[]
  shares        ExpenseShare[]

  @@index([groupId, type, date])
  @@index([groupId, date])
}

/// One member's slice of a non-bazar cost (rent, utilities, chef, wifi, ...).
/// Written for every split method so reporting never has to re-derive the maths,
/// and so a later membership change cannot silently rewrite last month's bill.
model ExpenseShare {
  id            String       @id @default(uuid())
  expense       ExpenseEntry @relation(fields: [expenseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expenseId     String
  user          User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  amount        Float
  createdAt     DateTime     @default(now())
  createdById   String?
  updatedAt     DateTime     @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean      @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@unique([expenseId, userId])
  @@index([userId])
}

model ExpenseItem {
  id            String       @id @default(uuid())
  expense       ExpenseEntry @relation(fields: [expenseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expenseId     String
  name          String
  amount        Float
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  createdById   String?
  updatedAt     DateTime     @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean      @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@index([expenseId])
}

model ExpenseComment {
  id            String       @id @default(uuid())
  expense       ExpenseEntry @relation(fields: [expenseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expenseId     String
  user          User         @relation("ExpenseCommentAuthor", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  groupId       String
  text          String
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  createdById   String?
  updatedAt     DateTime     @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean      @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@index([expenseId])
}

model PaymentStatus {
  id            String          @id @default(uuid())
  user          User            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  group         Group           @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  expense       ExpenseEntry?   @relation(fields: [expenseId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  expenseId     String?
  reversalOf    PaymentStatus?  @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversalOfId  String?         @unique
  reversedBy    PaymentStatus?  @relation("PaymentReversal")
  recordedBy    User?           @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recordedById  String?
  toUser        User?           @relation("PaymentRecipient", fields: [toUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  toUserId      String?
  offsetOf      PaymentStatus?  @relation("PaymentOffset", fields: [offsetOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  offsetOfId    String?         @unique
  offsetBy      PaymentStatus?  @relation("PaymentOffset")
  fromAdvance   Boolean         @default(false)
  amountDue     Float
  amountPaid    Float           @default(0)
  status        String
  dueDate       DateTime
  createdAt     DateTime      @default(now())
  createdById   String?
  updatedAt     DateTime      @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean       @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@index([groupId, dueDate])
  @@index([userId, dueDate])
  @@index([expenseId])
  @@index([toUserId])
}

/// A member's running advance wallet for a group — money handed to the supervisor
/// ahead of any specific bill so utilities can be paid the moment they're due.
/// A deposit is a positive row; a bill auto-consuming it writes a negative row
/// tagged with that bill's expenseId. The balance is just the signed sum, so it
/// naturally carries forward month to month until spent.
model MemberAdvance {
  id            String          @id @default(uuid())
  user          User            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  group         Group           @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  expense       ExpenseEntry?   @relation(fields: [expenseId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  expenseId     String?
  amount        Float
  note          String?
  recordedBy    User?           @relation("AdvanceRecorder", fields: [recordedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recordedById  String?
  reversalOf    MemberAdvance?  @relation("AdvanceReversal", fields: [reversalOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversalOfId  String?         @unique
  reversedBy    MemberAdvance?  @relation("AdvanceReversal")
  createdAt     DateTime        @default(now())
  createdById   String?
  updatedAt     DateTime        @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean         @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@index([groupId, userId])
  @@index([expenseId])
}

model GroupOrder {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
