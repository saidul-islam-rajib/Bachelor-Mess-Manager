generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(uuid())
  name            String
  email           String            @unique
  password        String
  phone           String?
  profileImage    String?
  role            String            @default("MEMBER")
  status          String            @default("PENDING")
  /// Bumped on password change so previously issued session cookies stop verifying.
  tokenVersion    Int               @default(0)
  lastLoginAt     DateTime?
  createdAt       DateTime          @default(now())
  createdById     String?
  updatedAt       DateTime          @updatedAt @default(now())
  updatedById     String?
  isPublished     Boolean           @default(true)
  publishedAt     DateTime?
  unpublishedAt   DateTime?
  memberships     Membership[]
  comments        Comment[]
  mealEntries     MealEntry[]
  mealPlans       MealPlan[]
  expensePayments ExpenseEntry[]    @relation("ExpensePayer")
  expenseHistory  ExpenseHistory[]  @relation("ExpenseHistoryActor")
  expenseComments ExpenseComment[]  @relation("ExpenseCommentAuthor")
  expenseShares   ExpenseShare[]
  commentReplies  CommentReply[]    @relation("CommentReplyAuthor")
  groupOrders     GroupOrder[]
  payments        PaymentStatus[]
  groupsSupervised Group[]          @relation("GroupSupervisor")
  invitationsReceived Invitation[]  @relation("InvitationInvitee")
  invitationsSent     Invitation[]  @relation("InvitationInviter")
}

model Group {
  id                  String          @id @default(uuid())
  name                String
  supervisor          User            @relation("GroupSupervisor", fields: [supervisorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supervisorId        String
  status              String          @default("ACTIVE")
  mealWeightBreakfast Float           @default(0.5)
  mealWeightLunch     Float           @default(1)
  mealWeightDinner    Float           @default(1)
  createdAt           DateTime        @default(now())
  createdById         String?
  updatedAt           DateTime        @updatedAt @default(now())
  updatedById         String?
  isPublished         Boolean         @default(true)
  publishedAt         DateTime?
  unpublishedAt       DateTime?
  memberships         Membership[]
  meals               MealEntry[]
  mealPlans           MealPlan[]
  expenses            ExpenseEntry[]
  expenseHistory      ExpenseHistory[]
  orders              GroupOrder[]
  payments            PaymentStatus[]
  comments            Comment[]
  invitations         Invitation[]
}

model SiteSettings {
  id                String    @id @default("singleton")
  companyName       String    @default("Team Sober")
  tagline           String?
  address           String?
  contactEmail      String?
  contactPhone      String?
  copyrightOwner    String    @default("Team Sober")
  facebookUrl       String?
  twitterUrl        String?
  newsletterEnabled Boolean   @default(true)
  createdAt         DateTime  @default(now())
  createdById       String?
  updatedAt         DateTime  @updatedAt @default(now())
  updatedById       String?
  isPublished       Boolean   @default(true)
  publishedAt       DateTime?
  unpublishedAt     DateTime?
}

model Subscriber {
  id            String    @id @default(uuid())
  email         String    @unique
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @updatedAt @default(now())
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
}

model Invitation {
  id            String    @id @default(uuid())
  group         Group     @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  invitee       User      @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inviteeId     String
  inviter       User      @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invitedById   String
  status        String    @default("PENDING")
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @updatedAt @default(now())
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
}

model Membership {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  group         Group     @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  joinedAt      DateTime  @default(now())
  leftAt        DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @updatedAt @default(now())
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
}

model MealEntry {
  id             String    @id @default(uuid())
  user           User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId         String
  group          Group     @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId        String
  date           DateTime
  breakfastCount Int       @default(0)
  lunchCount     Int       @default(0)
  dinnerCount    Int       @default(0)
  totalMeals     Int       @default(0)
  fromPlan       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  createdById    String?
  updatedAt      DateTime  @updatedAt @default(now())
  updatedById    String?
  isPublished    Boolean   @default(true)
  publishedAt    DateTime?
  unpublishedAt  DateTime?

  @@unique([userId, groupId, date])
}

model MealPlan {
  id            String        @id @default(uuid())
  user          User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  group         Group         @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  isActive      Boolean       @default(true)
  startDate     DateTime
  createdAt     DateTime      @default(now())
  createdById   String?
  updatedAt     DateTime      @updatedAt @default(now())
  updatedById   String?
  isPublished   Boolean       @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
  days          MealPlanDay[]

  @@unique([userId, groupId])
}

model MealPlanDay {
  id            String    @id @default(uuid())
  plan          MealPlan  @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  planId        String
  weekday       Int
  enabled       Boolean   @default(false)
  breakfast     Int       @default(0)
  lunch         Int       @default(0)
  dinner        Int       @default(0)
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @updatedAt @default(now())
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@unique([planId, weekday])
}

model ExpenseEntry {
  id            String          @id @default(uuid())
  group         Group           @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  type          String
  amount        Float
  date          DateTime
  payer         User?           @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  payerId       String?
  isReceived    Boolean         @default(false)
  splitMethod   String
  note          String?
  createdAt     DateTime        @default(now())
  createdById   String?
  updatedAt     DateTime        @updatedAt @default(now())
  updatedById   String?
  isPublished   Boolean         @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
  payments      PaymentStatus[]
  items         ExpenseItem[]
  comments      ExpenseComment[]
  shares        ExpenseShare[]
}

/// One member's slice of a non-bazar cost (rent, utilities, chef, wifi, ...).
/// Written for every split method so reporting never has to re-derive the maths,
/// and so a later membership change cannot silently rewrite last month's bill.
model ExpenseShare {
  id            String       @id @default(uuid())
  expense       ExpenseEntry @relation(fields: [expenseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expenseId     String
  user          User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  amount        Float
  createdAt     DateTime     @default(now())
  createdById   String?
  updatedAt     DateTime     @updatedAt @default(now())
  updatedById   String?
  isPublished   Boolean      @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@unique([expenseId, userId])
}

model ExpenseItem {
  id            String       @id @default(uuid())
  expense       ExpenseEntry @relation(fields: [expenseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expenseId     String
  name          String
  amount        Float
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  createdById   String?
  updatedAt     DateTime     @updatedAt @default(now())
  updatedById   String?
  isPublished   Boolean      @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
}

model ExpenseComment {
  id            String       @id @default(uuid())
  expense       ExpenseEntry @relation(fields: [expenseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expenseId     String
  user          User         @relation("ExpenseCommentAuthor", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  groupId       String
  text          String
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  createdById   String?
  updatedAt     DateTime     @updatedAt @default(now())
  updatedById   String?
  isPublished   Boolean      @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
}

model PaymentStatus {
  id            String        @id @default(uuid())
  user          User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  group         Group         @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  expense       ExpenseEntry? @relation(fields: [expenseId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  expenseId     String?
  amountDue     Float
  amountPaid    Float         @default(0)
  status        String
  dueDate       DateTime
  createdAt     DateTime      @default(now())
  createdById   String?
  updatedAt     DateTime      @updatedAt @default(now())
  updatedById   String?
  isPublished   Boolean       @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
}

model GroupOrder {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  group         Group     @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  position      Int
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @updatedAt @default(now())
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@unique([userId, groupId])
}

model ExpenseHistory {
  id            String    @id @default(uuid())
  expenseId     String?
  group         Group     @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  actor         User?     @relation("ExpenseHistoryActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorId       String?
  action        String
  expenseDate   DateTime?
  amountFrom    Float?
  amountTo      Float?
  dateFrom      DateTime?
  dateTo        DateTime?
  noteFrom      String?
  noteTo        String?
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @updatedAt @default(now())
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
}

model CommentReply {
  id            String    @id @default(uuid())
  comment       Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  commentId     String
  user          User      @relation("CommentReplyAuthor", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  text          String
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @updatedAt @default(now())
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
}

model Comment {
  id            String         @id @default(uuid())
  user          User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String
  group         Group          @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupId       String
  text          String
  deletedAt     DateTime?
  replies       CommentReply[]
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @updatedAt @default(now())
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?
}
