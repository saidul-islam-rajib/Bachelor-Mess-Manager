  createdById   String?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  unpublishedAt DateTime?

  @@unique([userId, groupId])
}

model ExpenseHistory {
