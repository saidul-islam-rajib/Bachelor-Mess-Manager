# Copy this file to `.env` and fill it in. `.env` is git-ignored.
# Every value below has a safe default except DATABASE_URL, AUTH_SECRET,
# ADMIN_EMAIL and ADMIN_PASSWORD.

# ============================================================== REQUIRED
# --- Database -----------------------------------------------------------
# Local SQL Server Express with Windows authentication:
DATABASE_URL="postgresql://bpadmin:password@localhost:5432/bachelor_point?schema=public"
# SQL Server / Azure SQL with username and password:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bachelor_point?schema=public"

# --- Connection pool ----------------------------------------------------
# Prisma defaults the pool to (CPU cores x 2 + 1), which is only 3 on a
# 1-vCPU container. A single page load fires ~8 API requests, so a small pool
# makes requests queue behind each other and eventually fail with
# "Timed out fetching a new connection from the connection pool" (500s).
# Raise it if the server logs show that error. Keep it below the database's
# own max connection count.
# DATABASE_CONNECTION_LIMIT=15
# Seconds a request waits for a free connection before failing (Prisma
# default is 10).
# DATABASE_POOL_TIMEOUT_SECONDS=15

# --- Session signing key ------------------------------------------------
# Signs the session cookie. Minimum 32 characters. The app refuses to start in
# production without it. Changing it signs everyone out.
#
# It also signs the SHARED `ts_identity` cookie, so this value must be
# BYTE-IDENTICAL in every Team Sober app (this one and team-sober.com). That
# shared secret is the whole of the single sign-on. Rotate them together, or
# everybody is signed out of everything.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-value-at-least-32-characters"

# --- Single sign-on across the Team Sober apps --------------------------
# The parent domain the shared session cookie is scoped to, so every subdomain
# can read it. Set this in production once this app is served from a
# team-sober.com subdomain. Leave it UNSET locally, which makes the cookie
# host-only and stops a dev session leaking between apps on different ports.
#
# Somebody arriving with a valid session from another Team Sober app is
# recognised without a password, but a brand-new account is still created
# PENDING and waits for an admin — signing in elsewhere is not approval here.
# SSO_COOKIE_DOMAIN=".team-sober.com"

# --- Administrator account ----------------------------------------------
# The admin is NEVER seeded. It is created from these variables, idempotently,
# on the first request the server handles, or by running: npm run admin:init
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="a-long-admin-password"
ADMIN_NAME="System Administrator"
# ADMIN_PHONE="+8801700000000"
# ADMIN_BOOTSTRAP_ENABLED="true"

# ============================================================== OPTIONAL
# --- Email quality (anti-spam signups) ----------------------------------
# See docs/SECURITY-HARDENING.md
# EMAIL_REQUIRE_MX="true"
# EMAIL_MX_RESOLVERS="1.1.1.1,8.8.8.8"
# EMAIL_MX_TIMEOUT_MS="3000"
# CLEANUP_UNVERIFIED_AFTER_HOURS="24"

# --- Email (SMTP) -------------------------------------------------------
# See docs/EMAIL-SETUP.md
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="saidul.is.rajib@gmail.com"
# SMTP_PASSWORD="your-16-char-app-password"
# SMTP_FROM="Bachelor Point <admin@team-sober.com>"
# SMTP_TIMEOUT_MS="15000"
# APP_PUBLIC_URL="http://localhost:3000"
# PASSWORD_TOKEN_HOURS="24"

# --- Branding -----------------------------------------------------------
# APP_NAME="Bachelor Point"
# APP_TAGLINE="Manage your mess without the arguments."
# APP_CURRENCY_CODE="BDT"
# APP_CURRENCY_SYMBOL="৳"
# APP_DATE_LOCALE="en-GB"
# The zone every calendar day is decided in: which day "today" is, which day a
# meal belongs to, and which hour a visit is bucketed into. Set this to where
# the mess actually is, not to UTC, or members past midnight local time will be
# logging meals against yesterday.
# APP_TIME_ZONE="Asia/Dhaka"
# APP_AUTHOR_NAME="Saidul Islam Rajib"
# APP_AUTHOR_EMAIL="saidul.is.rajib@gmail.com"
# Where the author's name in the footer links to.
# APP_AUTHOR_PROFILE_URL="https://www.facebook.com/saidul.is.rajib/"
# APP_LICENSE="MIT"
# APP_COPYRIGHT_START_YEAR="2026"

# --- Session ------------------------------------------------------------
# SESSION_COOKIE_NAME="bachelor_point_session"
# SESSION_MAX_AGE_SECONDS="2592000"
# SESSION_REFRESH_AFTER_SECONDS="86400"

# --- Password hashing ---------------------------------------------------
# PASSWORD_MIN_LENGTH="8"
# PASSWORD_MAX_LENGTH="200"
# PASSWORD_SCRYPT_COST="16384"
# PASSWORD_SCRYPT_BLOCK_SIZE="8"
# PASSWORD_SCRYPT_PARALLELISM="1"

# --- Security fallbacks -------------------------------------------------
# These are only the initial values. Once the database exists, an admin edits
# them live from Admin -> Security, and the database values win.
# SECURITY_MAX_LOGIN_ATTEMPTS="5"
# SECURITY_LOGIN_LOCKOUT_MINUTES="15"
# SECURITY_MAX_LOGIN_ATTEMPTS_PER_IP="40"
# SECURITY_IP_LOCKOUT_MINUTES="15"
# SECURITY_MAX_REGISTRATIONS_PER_IP="5"
# SECURITY_REGISTRATION_WINDOW_MINUTES="60"
# SECURITY_LOGIN_ATTEMPT_RETENTION_DAYS="30"
# Set to true when running behind a reverse proxy that sets X-Forwarded-For.
# SECURITY_TRUST_PROXY_HEADERS="false"

# --- Groups and validation ----------------------------------------------
# GROUP_MAX_PER_SUPERVISOR="10"
# GROUP_MAX_NAME_LENGTH="80"
# GROUP_MEAL_WEIGHT_BREAKFAST="0.5"
# GROUP_MEAL_WEIGHT_LUNCH="1"
# GROUP_MEAL_WEIGHT_DINNER="1"
# VALIDATION_NAME_MIN_LENGTH="2"
# VALIDATION_NAME_MAX_LENGTH="80"
# VALIDATION_PHONE_MIN_DIGITS="6"
# VALIDATION_PHONE_MAX_DIGITS="15"
# VALIDATION_MAX_MONEY_AMOUNT="100000000"

# --- Uploads ------------------------------------------------------------
# Profile images. Defaults to ./uploads at the project root. Point this at a
# mounted volume when the filesystem is ephemeral.
# UPLOAD_DIR="D:/data/bachelor-point-uploads"
# Starting profile photo limit for a fresh database. Once the app has run, the
# live limit comes from Admin -> Settings, not from here.
# UPLOAD_MAX_IMAGE_BYTES="2097152"
# The floor and ceiling an admin may choose between. The ceiling also sizes the
# profile route's request body limit, so raising it costs memory per upload.
# UPLOAD_MIN_CONFIGURABLE_IMAGE_BYTES="65536"
# UPLOAD_MAX_CONFIGURABLE_IMAGE_BYTES="10485760"

# --- UI and pagination --------------------------------------------------
# PAGINATION_PAGE_SIZE="20"
# PAGINATION_MAX_PAGE_SIZE="100"
# UI_TOAST_DURATION_MS="4000"
# UI_SEARCH_DEBOUNCE_MS="300"
# UI_MONTHS_BACK="11"
# UI_MONTHS_FORWARD="1"
# How many days either side of today the meals page shows before you ask it for
# the whole month.
# UI_MEAL_DAYS_BEFORE="2"
# UI_MEAL_DAYS_AFTER="2"

# --- Sample data --------------------------------------------------------
# `npm run seed:db` refuses to run when NODE_ENV=production unless SEED_ENABLED
# is explicitly true. Seeded accounts use their own email as the password.
# SEED_ENABLED="false"
# SEED_EMAIL_DOMAIN="bachelorpoint.local"
# SEED_SUPERVISORS="4"
# SEED_MEMBERS="120"
# SEED_GROUPS="10"
# SEED_MEMBERS_PER_GROUP="10"
# SEED_PENDING_USERS="5"
# SEED_REJECTED_USERS="3"
# SEED_SUBSCRIBERS="12"

# --- Community room -----------------------------------------------------
# The app-wide room every approved member belongs to. Sizes are per request,
# so raising them costs memory and query time on every poll.
# COMMUNITY_PAGE_SIZE="30"
# COMMUNITY_MESSAGE_MAX_LENGTH="1000"
# COMMUNITY_POLL_INTERVAL_MS="45000"
# COMMUNITY_DIRECTORY_SIZE="200"
# COMMUNITY_MENTION_CAP="25"
# COMMUNITY_EVERYONE_CAP="500"

# --- One-tap meal prompts -----------------------------------------------
# MEAL_PROMPT_DISPATCH_SECRET is required by the daily job
# (`npm run meals:prompt`). Without it the endpoint only accepts a signed-in
# admin or the group supervisor. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# MEAL_PROMPT_DISPATCH_SECRET=""
# MEAL_PROMPT_LEAD_DAYS="1"
# MEAL_PROMPT_VALID_HOURS="36"
# MEAL_PROMPT_TOKEN_BYTES="32"
# MEAL_PROMPT_BATCH_SIZE="200"
# MEAL_PROMPT_MAX_COUNT="9"
# Fallback counts when a member has no meal plan for that weekday.
# MEAL_PROMPT_DEFAULT_BREAKFAST="0"
# MEAL_PROMPT_DEFAULT_LUNCH="1"
# MEAL_PROMPT_DEFAULT_DINNER="1"
