# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# ---------------------------------------------------------------- database
# Microsoft SQL Server connection string.
#
# Local SQL Server Express with Windows authentication:
DATABASE_URL="sqlserver://localhost\SQLEXPRESS;database=mess_db;integratedSecurity=true;trustServerCertificate=true"
#
# SQL Server / Azure SQL with a username and password:
# DATABASE_URL="sqlserver://HOST:1433;database=mess_db;user=sa;password=YourPassword;encrypt=true;trustServerCertificate=true"

# ------------------------------------------------------------------- auth
# Signs the session cookie. Must be at least 32 characters and kept secret.
# The app refuses to start in production without it; changing it signs everyone out.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-value-at-least-32-characters"

# ---------------------------------------------------------------- uploads
# Where profile images are written. Defaults to ./uploads at the project root.
# Point this at a mounted volume when the app's filesystem is ephemeral.
# UPLOAD_DIR="D:/data/bachelor-point-uploads"
