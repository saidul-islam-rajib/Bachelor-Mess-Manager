pipeline {
  agent any

  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 30, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  environment {
    SERVER_IP     = credentials('server-ip')
    K8S_NAMESPACE = 'bachelor-point'
    APP_NAME      = 'bachelor-point'
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.GIT_SHA = sh(returnStdout: true, script: 'git rev-parse --short=12 HEAD').trim()
          currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.GIT_SHA}"
        }
      }
    }

    stage('Quality gate') {
      steps {
        sh 'npm ci'
        sh 'npx prisma generate'
        sh 'npm run typecheck'
        sh 'npm run lint'
      }
    }

    stage('Deploy to k3s') {
      steps {
        sshagent(credentials: ['ssh-key-ec2']) {
          sh '''
            chmod +x scripts/deploy-free-tier.sh
            TAG=${GIT_SHA} SSH_KEY="" ./scripts/deploy-free-tier.sh ${SERVER_IP}
          '''
        }
      }
    }

    stage('Verify') {
      steps {
        sh 'curl -fsS --max-time 15 --retry 5 --retry-delay 5 http://${SERVER_IP}.nip.io/api/health'
      }
    }
  }

  post {
    success {
      echo "Deployed ${env.GIT_SHA} to http://${env.SERVER_IP}.nip.io"
    }
    failure {
      sshagent(credentials: ['ssh-key-ec2']) {
        sh '''
          ssh -o StrictHostKeyChecking=no ubuntu@${SERVER_IP} \
            "cd /home/ubuntu/app && sudo KUBECTL='k3s kubectl' ./scripts/blue-green.sh status" || true
        '''
      }
      echo 'Deploy failed. Live traffic was not switched. Roll back with: ./scripts/blue-green.sh rollback'
    }
    always {
      cleanWs()
    }
  }
}
